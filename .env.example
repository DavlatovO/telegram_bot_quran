# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- Telegram --------------------------------------------------------------
# Bot token from @BotFather
bot_token=

# --- Webhook (required unless USE_POLLING=true) ---------------------------
# Public HTTPS origin Telegram will POST updates to (no trailing slash)
WEBHOOK_BASE_URL=https://your-app.example.com
# Path component Telegram posts to
WEBHOOK_PATH=/webhook
# Long random string; verified against the X-Telegram-Bot-Api-Secret-Token
# header on every incoming update
WEBHOOK_SECRET=

# --- HTTP server ---------------------------------------------------------
# Port the bot listens on (most PaaS platforms inject this)
PORT=8080

# --- Local development --------------------------------------------------
# Set true to use long polling instead of a webhook (no public URL needed)
USE_POLLING=false

# --- Admin notifications (optional) -------------------------------------
# When both are set, every inbound user message is forwarded to ADMIN_CHAT_ID
ADMIN_BOT_TOKEN=
ADMIN_CHAT_ID=

# --- Misc --------------------------------------------------------------
LOG_LEVEL=INFO
